NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=

RESEND_API_KEY=
# For real customers: a verified domain, e.g. Your Shop <hello@yourshop.com>
# The default below is Resend’s test sender and often only delivers to your Resend inbox.
RESEND_FROM_EMAIL=FollowUp AI <onboarding@resend.dev>

JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
NEXT_PUBLIC_JOBBER_CLIENT_ID=
# Optional. Jobber signs webhooks with JOBBER_CLIENT_SECRET by default.
JOBBER_WEBHOOK_SECRET=

CRON_SECRET=

# Optional. Used as the dashboard link in the owner due-digest email.
NEXT_PUBLIC_APP_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional analytics. Leave empty to load nothing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
